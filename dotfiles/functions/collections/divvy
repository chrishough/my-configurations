_dvy_links_about_chris_hough() {
  # +--------+----+----+
  # |        | 1  | 2  |
  # |   0    +----+----+
  # |        |    3    |
  # +--------+---------+
  local dir=~/Career/RobotsBuildingRobots/code/personal-branding/LinksAboutChrisHough
  local session=links_about_chris_hough

  tmux new-session -d -s "$session" -c "$dir" -x $(tput cols) -y $(tput lines) \; \
    splitw -h -p 40 -c "$dir" \; \
    splitw -v -p 65 -c "$dir" \; \
    selectp -t 1 \; \
    splitw -h -c "$dir" \; \
    select-layout -E \; \
    attach -t "$session"
}

_dvy_list() {
  echo
  echo "-------------------------------------------"
  echo " Available dvy layouts:"
  echo "-------------------------------------------"
  echo
  echo " dvy links_about_chris_hough"
  echo
  echo "-------------------------------------------"
  echo
}

dvy() {
  case "$1" in
    --list|-l)
      _dvy_list
      ;;
    links_about_chris_hough)
      _dvy_links_about_chris_hough
      ;;
    *)
      echo "Usage: dvy <layout_name> | dvy --list"
      echo "Run 'dvy --list' to see available layouts."
      ;;
  esac
}
