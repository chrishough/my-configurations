# DVY - Dynamic tmux layout manager
# Reads layouts from ~/.myconfigurations/applications/tmux/paths.json
_DVY_PATHS_FILE="$HOME/.myconfigurations.private/tmux/paths.json"

_dvy_next_session_name() {
  local base="$1"
  if ! tmux has-session -t "$base" 2>/dev/null; then
    echo "$base"
    return
  fi
  local i=2
  while tmux has-session -t "${base}_${i}" 2>/dev/null; do
    ((i++))
  done
  echo "${base}_${i}"
}

_dvy_set_tab_color() {
  local hex="${1#\#}"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))
  echo -ne "\033]6;1;bg;red;brightness;${r}\a"
  echo -ne "\033]6;1;bg;green;brightness;${g}\a"
  echo -ne "\033]6;1;bg;blue;brightness;${b}\a"
}

_dvy_reset_tab_color() {
  echo -ne "\033]6;1;bg;*;default\a"
}

# Layout: l1_r2
# +--------+---------+
# |        |    1    |
# |   0    +---------+
# |        |    2    |
# +--------+---------+
_dvy_layout_l1_r2() {
  local session="$1"
  local dir="$2"
  local config="$3"

  tmux new-session -d -s "$session" -c "$dir" -x $(tput cols) -y $(tput lines) \; \
    splitw -h -p 55 -c "$dir" \; \
    splitw -v -p 50 -c "$dir" \; \
    select-layout -E

  # Send commands to each pane (clear, custom command if specified, clear)
  for pane in 0 1 2; do
    tmux send-keys -t "$session:0.$pane" 'clear' Enter
    local cmd=$(echo "$config" | jq -r --arg p "$pane" '.[$p] // empty')
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "$session:0.$pane" "$cmd" Enter
      tmux send-keys -t "$session:0.$pane" 'clear' Enter
    fi
  done
}

# Layout: l1_r3
# +--------+----+----+
# |        | 1  | 2  |
# |   0    +----+----+
# |        |    3    |
# +--------+---------+
_dvy_layout_l1_r3() {
  local session="$1"
  local dir="$2"
  local config="$3"

  tmux new-session -d -s "$session" -c "$dir" -x $(tput cols) -y $(tput lines) \; \
    splitw -h -p 55 -c "$dir" \; \
    splitw -v -p 65 -c "$dir" \; \
    selectp -t 1 \; \
    splitw -h -c "$dir" \; \
    select-layout -E

  # Send commands to each pane (clear, custom command if specified, clear)
  for pane in 0 1 2 3; do
    tmux send-keys -t "$session:0.$pane" 'clear' Enter
    local cmd=$(echo "$config" | jq -r --arg p "$pane" '.[$p] // empty')
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "$session:0.$pane" "$cmd" Enter
      tmux send-keys -t "$session:0.$pane" 'clear' Enter
    fi
  done
}

# Layout: l1_r4
# +--------+---------+
# |        |    1    |
# |        +---------+
# |   0    |    2    |
# |        +---------+
# |        |    3    |
# |        +---------+
# |        |    4    |
# +--------+---------+
_dvy_layout_l1_r4() {
  local session="$1"
  local dir="$2"
  local config="$3"

  tmux new-session -d -s "$session" -c "$dir" -x $(tput cols) -y $(tput lines) \; \
    splitw -h -p 55 -c "$dir" \; \
    splitw -v -p 75 -c "$dir" \; \
    splitw -v -p 66 -c "$dir" \; \
    splitw -v -p 50 -c "$dir" \; \
    select-layout -E

  # Send commands to each pane (clear, custom command if specified, clear)
  for pane in 0 1 2 3 4; do
    tmux send-keys -t "$session:0.$pane" 'clear' Enter
    local cmd=$(echo "$config" | jq -r --arg p "$pane" '.[$p] // empty')
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "$session:0.$pane" "$cmd" Enter
      tmux send-keys -t "$session:0.$pane" 'clear' Enter
    fi
  done
}

# Layout: l2_r4
# +--------+---------+
# |   0    |    1    |
# |        +---------+
# |        |    2    |
# +--------+---------+
# |        |    3    |
# |   5    +---------+
# |        |    4    |
# +--------+---------+
_dvy_layout_l2_r4() {
  local session="$1"
  local dir="$2"
  local config="$3"

  # Create session with pane 0
  tmux new-session -d -s "$session" -c "$dir" -x $(tput cols) -y $(tput lines)

  # Split horizontally: pane 1 on right (50%)
  tmux split-window -h -p 50 -t "$session:0" -c "$dir"

  # Split right pane (1) vertically 3 times
  tmux split-window -v -p 75 -t "$session:0.1" -c "$dir"
  tmux split-window -v -p 66 -t "$session:0.2" -c "$dir"
  tmux split-window -v -p 50 -t "$session:0.3" -c "$dir"

  # Split left pane (0) vertically once
  tmux split-window -v -p 50 -t "$session:0.0" -c "$dir"

  tmux select-layout -t "$session:0" -E

  for pane in 0 1 2 3 4 5; do
    tmux send-keys -t "$session:0.$pane" 'clear' Enter
    local cmd=$(echo "$config" | jq -r --arg p "$pane" '.[$p] // empty')
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "$session:0.$pane" "$cmd" Enter
      tmux send-keys -t "$session:0.$pane" 'clear' Enter
    fi
  done
}

_dvy_list() {
  echo
  echo "-------------------------------------------"
  echo " Available dvy layouts:"
  echo "-------------------------------------------"
  echo

  if [[ -f "$_DVY_PATHS_FILE" ]]; then
    jq -r 'keys[]' "$_DVY_PATHS_FILE" | while read -r session; do
      echo " dvy $session"
    done
  else
    echo " No layouts configured."
    echo " Add entries to: $_DVY_PATHS_FILE"
  fi

  echo
  echo "-------------------------------------------"
  echo " Active tmux sessions:"
  echo "-------------------------------------------"
  echo

  if tmux list-sessions 2>/dev/null; then
    :
  else
    echo " No active sessions."
  fi

  echo
  echo "-------------------------------------------"
  echo
}

dvy() {
  local flag=""
  local session=""

  # Parse arguments
  case "$1" in
    --kill)
      tmux kill-server 2>/dev/null || echo "\nNo server running my friend!\n"
      return
      ;;
    --list|-l)
      _dvy_list
      return
      ;;
    --help|-h)
      dvyhelp
      return
      ;;
    "")
      echo "Usage: dvy <session_name> | dvy -a <session> | dvy -d <session>"
      echo "Run 'dvy --list' to see available layouts."
      return
      ;;
    -a|-d)
      flag="$1"
      session="$2"
      if [[ -z "$session" ]]; then
        echo "Error: Session name required."
        echo "Usage: dvy $flag <session_name>"
        return 1
      fi
      ;;
    *)
      session="$1"
      ;;
  esac

  # Handle -a (attach) flag
  if [[ "$flag" == "-a" ]]; then
    if tmux has-session -t "$session" 2>/dev/null; then
      tmux attach -t "$session"
    else
      echo "Error: Session '$session' does not exist."
      echo "Run 'dvy --list' to see active sessions."
      return 1
    fi
    return
  fi

  # Handle -d (delete) flag
  if [[ "$flag" == "-d" ]]; then
    if tmux has-session -t "$session" 2>/dev/null; then
      tmux kill-session -t "$session"
      echo "Session '$session' killed."
    else
      echo "Error: Session '$session' does not exist."
    fi
    return
  fi

  # Default: create new session
  if [[ ! -f "$_DVY_PATHS_FILE" ]]; then
    echo "Error: Paths file not found: $_DVY_PATHS_FILE"
    return 1
  fi

  local config
  config=$(jq -r --arg s "$session" '.[$s] // empty' "$_DVY_PATHS_FILE")

  if [[ -z "$config" ]]; then
    echo "Error: Layout '$session' not found."
    echo "Run 'dvy --list' to see available layouts."
    return 1
  fi

  local layout dir
  layout=$(echo "$config" | jq -r '.layout')
  dir=$(echo "$config" | jq -r '.dir')

  # Expand ~ to $HOME
  dir="${dir/#\~/$HOME}"

  # Get next available session name (auto-suffix if exists)
  session=$(_dvy_next_session_name "$session")

  case "$layout" in
    l1_r2)
      _dvy_layout_l1_r2 "$session" "$dir" "$config"
      ;;
    l1_r3)
      _dvy_layout_l1_r3 "$session" "$dir" "$config"
      ;;
    l1_r4)
      _dvy_layout_l1_r4 "$session" "$dir" "$config"
      ;;
    l2_r4)
      _dvy_layout_l2_r4 "$session" "$dir" "$config"
      ;;
    *)
      echo "Error: Unknown layout type: $layout"
      return 1
      ;;
  esac

  # Set iTerm2 tab color if configured, attach, then reset on detach
  local tab_color
  tab_color=$(echo "$config" | jq -r '.tab_color // empty')
  if [[ -n "$tab_color" ]]; then
    _dvy_set_tab_color "$tab_color"
  fi

  tmux attach -t "$session"

  # Reset tab color after detach/exit
  if [[ -n "$tab_color" ]]; then
    _dvy_reset_tab_color
  fi
}

