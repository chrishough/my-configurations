#!/bin/zsh

# SETTINGS AND PRIVATE VARIABLES : NEVER CHECK IN THIS FILE!
source $HOME/.myconfigurations.private

# ADJUST SHELL HISTORY
export HISTFILESIZE=10000
export HISTSIZE=10000
PROMPT_COMMAND='history -a'

# SET BROWSER FOR SHELL COMMANDS
export BROWSER='open -a /Applications/Google Chrome.app'

# DEFAULT EDITOR
export EDITOR=vim

# IMPORT FUNCTIONS GROUPS
_myconfig_modules=(itermocil ror git brew python pg heroku js shell)

for _module in "${_myconfig_modules[@]}"; do
  source "$HOME/.myconfigurations/dotfiles/functions/collections/$_module"
done

# CLEAN UP TEMPORARY VARIABLES
unset _myconfig_modules _module

# AUTOJUMP
export AUTOJUMP_IGNORE_CASE=1

# ZSH AUTOCOMPLETE
autoload -U compinit && compinit

# ZSH HELP
function help() {
  echo
  echo "-------------------------------------------"
  echo
  echo "  brewhelp"
  echo "  githelp"
  echo "  dvyhelp"
  echo "  pghelp"
  echo "  rubyhelp"
  echo "  shellhelp"
  echo "  herokuhelp"
  echo
  echo "-------------------------------------------"
  echo
}
