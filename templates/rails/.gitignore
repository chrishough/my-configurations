#--------------------------------------------
# IGNORE SPECIFIC WORKSTATION CONFIGURATION
#--------------------------------------------
*.vscode
*.idea

#--------------------------------------------
# APPLICATION
#--------------------------------------------
/config/master.key

# Ignore precompiled assets in development
/public/assets

# Never check in environment variables file!
.env

#--------------------------------------------
# IGNORE ALL LOGFILES AND TEMPFILES
#--------------------------------------------
/.bundle
coverage
/storage/*
!/storage/.keep
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
spec/persist_specs.txt
.byebug_history
scratch.rb

#--------------------------------------------
# IGNORE THESE FILE TYPES
#--------------------------------------------
*.com
*.class
*.dll
*.exe
*.o
*.so
*.ase
*.ai
*.eps
*.7z
*.dmg
*.iso
*.jar
*.rar
*.tar
*.log
*.sql
*.sqlite
*.gz
*.svn
*.chef
*.vagrant

#--------------------------------------------
# OS GENERATED FILES
#--------------------------------------------
*.DS_Store
*.DS_Store?
*._*
*.Spotlight-V100
*.Trashes
*.*~
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules
